{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcpware.dev/schemas/intentprobe-multihead-receipt-v1.schema.json",
  "title": "IntentProbe Multi-head Decision Receipt v1",
  "description": "Provenance and timing receipt for one runtime event evaluated by one or more activation-readout heads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_version",
    "runtime_version",
    "event_id",
    "created_at",
    "input_fingerprint",
    "backbone_runs",
    "decisions",
    "timing"
  ],
  "properties": {
    "receipt_version": {
      "const": "1.0.0"
    },
    "runtime_version": {
      "$ref": "#/$defs/non_empty_string"
    },
    "event_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "input_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "payload_retained"],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "payload_retained": {
          "type": "boolean"
        }
      }
    },
    "backbone_runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "model_id", "model_revision", "renderer_id", "renderer_version", "hidden_outputs", "device", "dtype", "elapsed_seconds"],
        "properties": {
          "run_id": {
            "$ref": "#/$defs/non_empty_string"
          },
          "model_id": {
            "$ref": "#/$defs/non_empty_string"
          },
          "model_revision": {
            "$ref": "#/$defs/non_empty_string"
          },
          "renderer_id": {
            "$ref": "#/$defs/non_empty_string"
          },
          "renderer_version": {
            "$ref": "#/$defs/non_empty_string"
          },
          "hidden_outputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "device": {
            "$ref": "#/$defs/non_empty_string"
          },
          "dtype": {
            "$ref": "#/$defs/non_empty_string"
          },
          "elapsed_seconds": {
            "$ref": "#/$defs/non_negative_number"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "probe_id",
          "probe_version",
          "manifest_sha256",
          "backbone_run_id",
          "readout",
          "raw_output",
          "calibrated_output",
          "predicted_label",
          "abstained",
          "operating_point",
          "policy",
          "head_elapsed_seconds"
        ],
        "properties": {
          "probe_id": {
            "$ref": "#/$defs/non_empty_string"
          },
          "probe_version": {
            "$ref": "#/$defs/non_empty_string"
          },
          "manifest_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "backbone_run_id": {
            "$ref": "#/$defs/non_empty_string"
          },
          "readout": {
            "type": "object",
            "additionalProperties": false,
            "required": ["token_region", "pooling", "hidden_outputs", "layer_combination", "normalization"],
            "properties": {
              "token_region": {
                "$ref": "#/$defs/non_empty_string"
              },
              "pooling": {
                "$ref": "#/$defs/non_empty_string"
              },
              "hidden_outputs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "layer_combination": {
                "$ref": "#/$defs/non_empty_string"
              },
              "normalization": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          },
          "raw_output": {
            "oneOf": [
              { "type": "number" },
              {
                "type": "object",
                "additionalProperties": { "type": "number" }
              }
            ]
          },
          "calibrated_output": {
            "oneOf": [
              { "type": "number" },
              {
                "type": "object",
                "additionalProperties": { "type": "number" }
              }
            ]
          },
          "predicted_label": {
            "type": ["string", "null"]
          },
          "abstained": {
            "type": "boolean"
          },
          "operating_point": {
            "$ref": "#/$defs/non_empty_string"
          },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["policy_id", "policy_version", "decision", "reasons"],
            "properties": {
              "policy_id": {
                "$ref": "#/$defs/non_empty_string"
              },
              "policy_version": {
                "$ref": "#/$defs/non_empty_string"
              },
              "decision": {
                "type": "string",
                "enum": ["allow", "warn", "review", "block", "route", "write", "skip", "abstain"]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "head_elapsed_seconds": {
            "$ref": "#/$defs/non_negative_number"
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["render_seconds", "backbone_seconds", "heads_seconds", "policy_seconds", "total_seconds"],
      "properties": {
        "render_seconds": {
          "$ref": "#/$defs/non_negative_number"
        },
        "backbone_seconds": {
          "$ref": "#/$defs/non_negative_number"
        },
        "heads_seconds": {
          "$ref": "#/$defs/non_negative_number"
        },
        "policy_seconds": {
          "$ref": "#/$defs/non_negative_number"
        },
        "total_seconds": {
          "$ref": "#/$defs/non_negative_number"
        }
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_negative_number": {
      "type": "number",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
